 // queueWait extracts server-provided wait time from a queued/overload body.
 // Upstream signals queueing with {"code":"10605",...} or {"queue":{"isQueued":true,"waitTime":ms}}.
 func queueWait(body []byte) (time.Duration, bool) {
 	var parsed struct {
 		Code         string `json:"code"`
+		Message      string `json:"message"`
 		RetryAfterMs int64  `json:"retryAfterMs"`
 		Queue        *struct {
 			IsQueued bool  `json:"isQueued"`
@@ -313,6 +399,15 @@ func queueWait(body []byte) (time.Duration, bool) {
 		}
 		return time.Duration(ms) * time.Millisecond, true
 	}
+	// CN 上游把真实信号塞在 message 字段里（二次转义的 JSON 字符串）：
+	//   {"code":"10605","message":"{\"isQueued\":false,\"retryAfterSeconds\":2,...}"}
+	// 只匹配外层 code 会漏掉这种形态，必须下沉一层再解析。
+	if strings.Contains(string(body), "10605") {
+		if ms := nestedRetryAfterMs(parsed.Message); ms > 0 {
+			return time.Duration(ms) * time.Millisecond, true
+		}
+		return 2 * time.Second, true
+	}
 	return 0, false
 }
 
