+// peekQueuedSSE 预读上游 200 响应的首个 SSE 事件，判断它是否为队列/负载错误。
+//
+// CN 版 gateway.qoder.com.cn 的信号形态：
+//
+//	data:{"headers":{...},"body":"{\"code\":\"10605\",\"message\":\"{...retryAfterSeconds:2...}\"}","statusCodeValue":403}
+//
+// 返回 (wake, wait, err)：
+//   - wait > 0    → 命中队列信号，调用方按该时长重试；body 已关闭
+//   - wake != nil → 未命中队列，wake 是「首帧 + 剩余流」的重组 reader
+//   - err != nil  → 读取/解析失败
+func peekQueuedSSE(resp *http.Response) (io.ReadCloser, time.Duration, error) {
+	br := bufio.NewReaderSize(resp.Body, 64*1024)
+	var head bytes.Buffer
+	for {
+		line, err := br.ReadString('\n')
+		head.WriteString(line)
+		if err != nil {
+			return io.NopCloser(io.MultiReader(bytes.NewReader(head.Bytes()), br)), 0, nil
+		}
+		if strings.TrimSpace(line) != "" {
+			continue
+		}
+		break
+	}
+	headBytes := head.Bytes()
+	if wait, queued := queueWait(headBytes); queued {
+		return nil, wait, nil
+	}
+	var env struct {
+		StatusCodeValue int    `json:"statusCodeValue"`
+		Body            string `json:"body"`
+	}
+	if json.Unmarshal([]byte(extractSSEData(headBytes)), &env) == nil && env.StatusCodeValue != 0 && env.StatusCodeValue != 200 {
+		if wait, queued := queueWait([]byte(env.Body)); queued {
+			return nil, wait, nil
+		}
+	}
+	return io.NopCloser(io.MultiReader(bytes.NewReader(headBytes), br)), 0, nil
+}
+
+// extractSSEData 从 SSE 事件块里取出 data: 之后的负载。
+func extractSSEData(chunk []byte) string {
+	var out strings.Builder
+	for _, line := range strings.Split(string(chunk), "\n") {
+		trim := strings.TrimSpace(line)
+		if !strings.HasPrefix(trim, "data:") {
+			continue
+		}
+		d := strings.TrimSpace(strings.TrimPrefix(trim, "data:"))
+		if d == "" {
+			continue
+		}
+		if out.Len() > 0 {
+			out.WriteByte('\n')
+		}
+		out.WriteString(d)
+	}
+	return out.String()
+}
+
+// nestedRetryAfterMs 从内层 message 里提取 retryAfterSeconds / waitTime（毫秒）。
+func nestedRetryAfterMs(message string) int64 {
+	if message == "" {
+		return 0
+	}
+	var inner struct {
+		RetryAfterSeconds int64 `json:"retryAfterSeconds"`
+		RetryAfterMs      int64 `json:"retryAfterMs"`
+		WaitTime          int64 `json:"waitTime"`
+	}
+	if json.Unmarshal([]byte(message), &inner) != nil {
+		return 0
+	}
+	if inner.RetryAfterSeconds > 0 {
+		return inner.RetryAfterSeconds * 1000
+	}
+	if inner.RetryAfterMs > 0 {
+		return inner.RetryAfterMs
+	}
+	if inner.WaitTime > 0 {
+		return inner.WaitTime
+	}
+	return 0
+}
